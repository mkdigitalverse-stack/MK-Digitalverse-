# MK Digitalverse Production Environment Variables
# Note: All client-side parameters are prefixed with VITE_ for Vite bundling.
# None of these variables expose private backend secrets.

# Primary Website Domain (Canonical)
VITE_SITE_URL=https://mkdigitalverse.com

# Google Analytics 4 (GA4) Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID (e.g. 123456789012345)
VITE_META_PIXEL_ID=

# Google Ads Conversion Tracking
VITE_GADS_CONVERSION_ID=
VITE_GADS_CONVERSION_LABEL=

# Firebase Client API Key (Optional cloud persistence fallback)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
