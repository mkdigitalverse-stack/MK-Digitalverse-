{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Unified lead record captured from marketing growth audit, discovery call, or contact forms.",
      "type": "object",
      "properties": {
        "contactName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Full name of the healthcare executive or decision-maker."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120,
          "description": "Work email address."
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Direct phone or WhatsApp number."
        },
        "organizationName": {
          "type": "string",
          "maxLength": 120,
          "description": "Healthcare organization or clinical practice name."
        },
        "website": {
          "type": "string",
          "maxLength": 200,
          "description": "Current organization website URL."
        },
        "location": {
          "type": "string",
          "maxLength": 100,
          "description": "City / Region / Country."
        },
        "healthcareCategory": {
          "type": "string",
          "maxLength": 100,
          "description": "Specialty or sector (e.g., Specialty Clinic, Multi-specialty Hospital, HealthTech)."
        },
        "biggestChallenge": {
          "type": "string",
          "maxLength": 1000,
          "description": "Primary patient acquisition or operational bottleneck."
        },
        "growthObjective": {
          "type": "string",
          "maxLength": 1000,
          "description": "Target revenue or patient volume objective."
        },
        "investmentReadiness": {
          "type": "string",
          "maxLength": 100,
          "description": "Budget tier or timeline readiness."
        },
        "leadType": {
          "type": "string",
          "enum": ["growth_audit", "discovery_call", "contact_enquiry"],
          "description": "Originating conversion mechanism."
        },
        "status": {
          "type": "string",
          "enum": ["new", "contacted", "qualified", "proposal", "won", "lost"],
          "description": "Controlled internal lead lifecycle status."
        },
        "utm_source": { "type": "string", "maxLength": 100 },
        "utm_medium": { "type": "string", "maxLength": 100 },
        "utm_campaign": { "type": "string", "maxLength": 100 },
        "utm_content": { "type": "string", "maxLength": 100 },
        "utm_term": { "type": "string", "maxLength": 100 },
        "gclid": { "type": "string", "maxLength": 150 },
        "fbclid": { "type": "string", "maxLength": 150 },
        "landingPage": { "type": "string", "maxLength": 250 },
        "referrer": { "type": "string", "maxLength": 250 },
        "createdAt": { "type": "string", "description": "ISO timestamp or server time" },
        "updatedAt": { "type": "string", "description": "ISO timestamp or server time" }
      },
      "required": ["contactName", "email", "leadType", "status"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Email newsletter subscriber captured from the site footer.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120,
          "description": "Subscriber work email address."
        },
        "source": {
          "type": "string",
          "maxLength": 50,
          "description": "Source location of signup."
        },
        "utm_source": { "type": "string", "maxLength": 100 },
        "utm_medium": { "type": "string", "maxLength": 100 },
        "utm_campaign": { "type": "string", "maxLength": 100 },
        "subscribedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["email", "source"]
    }
  },
  "firestore": {
    "/leads": {
      "schema": "Lead",
      "description": "Collection storing executive healthcare leads."
    },
    "/subscribers": {
      "schema": "Subscriber",
      "description": "Collection storing newsletter subscribers."
    }
  }
}
