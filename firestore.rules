rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helper Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        (request.auth.token.get('email', '') == 'mkdigitalverse@gmail.com' && request.auth.token.get('email_verified', false) == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Lead Schema Validation Helper
    function isValidLead(data) {
      return data.keys().hasAll(['contactName', 'email', 'leadType', 'status'])
        && data.contactName is string && data.contactName.size() >= 2 && data.contactName.size() <= 100
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.leadType in ['growth_audit', 'discovery_call', 'contact_enquiry']
        && data.status == 'new'
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('organizationName' in data) || (data.organizationName is string && data.organizationName.size() <= 120))
        && (!('website' in data) || (data.website is string && data.website.size() <= 200))
        && (!('location' in data) || (data.location is string && data.location.size() <= 100))
        && (!('healthcareCategory' in data) || (data.healthcareCategory is string && data.healthcareCategory.size() <= 100))
        && (!('biggestChallenge' in data) || (data.biggestChallenge is string && data.biggestChallenge.size() <= 1000))
        && (!('growthObjective' in data) || (data.growthObjective is string && data.growthObjective.size() <= 1000))
        && (!('investmentReadiness' in data) || (data.investmentReadiness is string && data.investmentReadiness.size() <= 100))
        && !('notificationStatus' in data)
        && !('notificationAttempts' in data)
        && !('lastNotificationAttempt' in data)
        && !('notificationSentAt' in data)
        && !('internalNotificationId' in data)
        && !('internalNotificationError' in data)
        && !('fitStatus' in data)
        && !('leadPriority' in data)
        && !('intentLevel' in data)
        && !('growthStage' in data)
        && !('healthcareCategoryNormalized' in data)
        && !('challengeCategory' in data)
        && !('fitScore' in data)
        && !('internalNotes' in data)
        && !('assignedTo' in data)
        && !('nextFollowUpAt' in data)
        && !('lastContactedAt' in data)
        && !('qualificationReviewedAt' in data)
        && !('opportunityStage' in data)
        && !('derivedLeadSource' in data)
        && !('estimatedOpportunityValue' in data)
        && !('currency' in data)
        && !('weightedPipelineValue' in data)
        && !('stageProbability' in data)
        && !('stageEnteredAt' in data)
        && !('stageChangedAt' in data)
        && !('nextAction' in data)
        && !('lastUpdatedBy' in data)
        && !('discoveryDate' in data)
        && !('decisionMaker' in data)
        && !('decisionTimeline' in data)
        && !('proposalStatus' in data)
        && !('proposalValue' in data)
        && !('proposalSentAt' in data)
        && !('proposalFollowUpAt' in data)
        && !('negotiationStatus' in data)
        && !('expectedDecisionDate' in data)
        && !('negotiationNotes' in data)
        && !('wonDate' in data)
        && !('finalContractValue' in data)
        && !('lostDate' in data)
        && !('lostReason' in data)
        && !('lostNotes' in data);
    }

    // Subscriber Schema Validation Helper
    function isValidSubscriber(data) {
      return data.keys().hasAll(['email', 'source'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.source is string && data.source.size() <= 50;
    }

    // Collection Rules: Leads
    match /leads/{leadId} {
      allow create: if isValidId(leadId) && isValidLead(incoming());
      allow read: if isAdmin();
      allow update: if isAdmin() && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if false;

      match /activities/{activityId} {
        allow read, write: if isAdmin();
      }
    }

    // Collection Rules: Subscribers
    match /subscribers/{subId} {
      allow create: if isValidId(subId) && isValidSubscriber(incoming());
      allow read, update, delete: if isAdmin();
    }
  }
}
